## Audience Studio API connection
## URL of the AS instance SP talks to. The API key here is the FALLBACK key
## used only for unauthenticated server-side helpers (audience list during the
## brief wizard, etc). Per-user requests use the logged-in user's company key.
AUDIENCE_STUDIO_URL=http://localhost:3001
AUDIENCE_STUDIO_API_KEY=sk-bnt-syntheticp-XXXXXXXXXXXX

## Anthropic — used by /api/brief
ANTHROPIC_API_KEY=sk-ant-...

## Supabase — shared with Audience Studio. Same project, same auth.users.
## Get these from the AS .env.local; both apps point at the same Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

## URL SP is reachable at (used to build invite acceptance links).
NEXT_PUBLIC_SP_BASE_URL=http://localhost:3000
